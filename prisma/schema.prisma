generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//////////////////////////////////////////////////////
// USERS (Unified entity for hierarchy + RBAC)
//////////////////////////////////////////////////////

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  phone        String?
  password     String?
  address      String?
  role         String // ADMIN, DISTRIBUTOR, DEALER, CUSTOMER
  parentUserId String?
  status       String @default("Active")
  type         String 
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt


  // Self-referencing hierarchy
  parentUser User?  @relation("UserHierarchy", fields: [parentUserId], references: [id])
  childUsers User[] @relation("UserHierarchy")

  // Billing relations
  billingsAsUser   Billing[] @relation("BillingUser")
  billingsAsSeller Billing[] @relation("BillingSeller")

  // User subscription data
  userPlans            UserPlan[]
  userChannels         UserChannel[]
  userChannelHistories UserChannelHistory[]

  @@map("Users")
}

//////////////////////////////////////////////////////
// INVENTORY (Products like STB, Remote, etc.)
//////////////////////////////////////////////////////

model InventoryItem {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal @db.Decimal(10, 2)
  category    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  billingItems BillingItem[]

  @@map("InventoryItems")
}

//////////////////////////////////////////////////////
// BILLING (Unified Ledger: Monthly + Product Sales)
//////////////////////////////////////////////////////

model Billing {
  id          String   @id @default(uuid())
  userId      String
  sellerId    String?
  billingDate DateTime
  billingType String // PRODUCT_SALE, MONTHLY_BILL, ADD_CHANNEL, REMOVE_CHANNEL, PLAN_RENEW
  totalAmount Decimal @db.Decimal(10, 2)
  status      String  // PENDING, PAID, FINALIZED
  createdAt   DateTime @default(now())

  user   User  @relation("BillingUser", fields: [userId], references: [id])
  seller User? @relation("BillingSeller", fields: [sellerId], references: [id])

  billingItems     BillingItem[]
  billingHistories BillingHistory[]

  @@map("Billings")
}

//////////////////////////////////////////////////////
// BILLING ITEMS (Line Items inside Billing)
//////////////////////////////////////////////////////

model BillingItem {
  id          String   @id @default(uuid())
  billingId   String
  itemType    String // PRODUCT, PLAN, CHANNEL, TAX, DISCOUNT
  inventoryId String?
  channelId   String?
  planId      String?
  description String?
  quantity    Int     @default(1)
  price       Decimal @db.Decimal(10, 2)

  billing       Billing        @relation(fields: [billingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryId], references: [id])
  channel       Channel?       @relation(fields: [channelId], references: [id])
  plan          Plan?          @relation(fields: [planId], references: [id])

  @@map("BillingItems")
}

//////////////////////////////////////////////////////
// BILLING HISTORY (Frozen Invoice Snapshots)
//////////////////////////////////////////////////////

model BillingHistory {
  id        String   @id @default(uuid())
  billingId String
  metadata  Json
  createdAt DateTime @default(now())

  billing Billing @relation(fields: [billingId], references: [id], onDelete: Cascade)

  @@map("BillingHistories")
}

//////////////////////////////////////////////////////
// PLANS (Templates)
//////////////////////////////////////////////////////

model Plan {
  id        String   @id @default(uuid())
  name      String
  type      String @default("DPO")
  price     Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  planChannels PlanChannel[]
  userPlans    UserPlan[]
  billingItems BillingItem[]

  @@map("Plans")
}

model Channel {
  id        String   @id @default(uuid())
  name      String
  price     Decimal @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  planChannels         PlanChannel[]
  userChannels         UserChannel[]
  userChannelHistories UserChannelHistory[]
  billingItems         BillingItem[]

  @@map("Channels")
}

model PlanChannel {
  id        String @id @default(uuid())
  planId    String
  channelId String

  plan    Plan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([planId, channelId])
  @@map("PlanChannels")
}

//////////////////////////////////////////////////////
// USER PLAN (Multiple allowed, no history table)
//////////////////////////////////////////////////////

model UserPlan {
  id        String   @id @default(uuid())
  userId    String
  planId    String
  status    String @default("ACTIVE") // ACTIVE, INACTIVE, CANCELLED
  startDate DateTime
  endDate   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("UserPlans")
}

//////////////////////////////////////////////////////
// USER CHANNELS (Current Snapshot)
//////////////////////////////////////////////////////

model UserChannel {
  id        String   @id @default(uuid())
  userId    String
  channelId String
  price     Decimal @db.Decimal(10, 2)
  addedFrom String // PLAN, MANUAL, PROMO
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("UserChannels")
}

//////////////////////////////////////////////////////
// USER CHANNEL HISTORY (Daily Snapshot)
//////////////////////////////////////////////////////

model UserChannelHistory {
  id        String   @id @default(uuid())
  userId    String
  channelId String
  price     Decimal @db.Decimal(10, 2)
  metadata  Json
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("UserChannelHistories")
}