{
  "name": "super-vidya-backend",
  "version": "1.0.05",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "rm -rf build && tsc && tsc-alias",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix **/*.ts",
    "format:write": "prettier --write **/*.ts",
    "format:check": "prettier --check **/*.ts",
    "prepare": "husky install",
    "ts.check": "tsc --project tsconfig.json",
    "add-build": "git add build",
    "start:prod": "pm2 startOrRestart ./pm2/ecosystem.prod.config.json --only super-vidya-prod",
    "start:staging": "pm2 startOrRestart ./pm2/ecosystem.staging.config.json --only supervidya-staging",
    "db:migrate:dev": "npx prisma migrate dev --name init",
    "db:migrate:test": "npx prisma migrate deploy",
    "db:migrate:prod": "npx prisma migrate deploy",
    "db:generate": "npx prisma generate",
    "db:seed": "npx ts-node-dev prisma/seed.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --check"
    ],
    "*.{json,yml,yaml,md}": [
      "prettier --check"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-sqs": "^3.882.0",
    "@aws-sdk/s3-request-presigner": "^3.879.0",
    "@google/genai": "^1.21.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^0.3.77",
    "@langchain/google-genai": "^0.2.18",
    "@prisma/client": "^6.16.1",
    "@sendgrid/mail": "^8.1.5",
    "@sentry/node": "^10.19.0",
    "@sentry/profiling-node": "^10.19.0",
    "@sentry/tracing": "^7.120.4",
    "@types/multer": "^2.0.0",
    "adaptive-expressions": "^4.23.3",
    "async-retry": "^1.3.3",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.9.0",
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.7.0",
    "http-method-enum": "^1.0.0",
    "http-status": "^1.5.3",
    "joi": "^17.7.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.5.48",
    "ms-teams-webhook": "^2.2.2",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^11.1.0",
    "winston": "^3.8.2",
    "xlsx": "^0.18.5",
    "xss-filters": "^1.2.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@babel/node": "^7.27.1",
    "@eslint/js": "^9.38.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/async-retry": "^1.4.9",
    "@types/aws-sdk": "^0.0.42",
    "@types/bcrypt": "^5.0.2",
    "@types/bcryptjs": "^2.4.2",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.3",
    "@types/node": "^18.19.102",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/xlsx": "^0.0.35",
    "@types/xss-filters": "^0.0.27",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "cross-env": "^7.0.3",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "husky": "^8.0.3",
    "lint-staged": "^13.3.0",
    "node-mocks-http": "^1.12.1",
    "nodemon": "^2.0.20",
    "pre-commit": "^1.2.2",
    "prettier": "^2.8.1",
    "prisma": "^6.15.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.2"
  }
}
